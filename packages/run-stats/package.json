{
  "name": "@clockwyrks/run-stats",
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "description": "Framework-free run scoring and set-level rollups: the rules every surface that reports a Test Cabinet figure shares.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClockwyrks/ui-common.git",
    "directory": "packages/run-stats"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@clockwyrks/backend-api": "0.2.5",
    "@clockwyrks/run-record": "0.2.5"
  },
  "devDependencies": {
    "typescript": "^6",
    "vitest": "^5"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/genyume/the-test-cabinet/_packaging/the-test-cabinet/npm/registry/"
  }
}
