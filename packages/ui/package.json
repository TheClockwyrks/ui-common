{
  "name": "@clockwyrks/ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Shared frontend library for The Test Cabinet's GUIs: the full routed gallery application, brand-neutral presentational primitives, and the transport-agnostic backend/worker client interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClockwyrks/ui-common.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./routes": {
      "types": "./dist/app/routes.d.ts",
      "default": "./dist/app/routes.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/copy-assets.mjs --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:preview": "vite --config preview/vite.config.ts"
  },
  "dependencies": {
    "@clockwyrks/backend-api": "0.2.4",
    "@clockwyrks/lattice-runtime": "1.1.2",
    "@clockwyrks/particle-runtime": "1.1.2",
    "@clockwyrks/run-record": "0.2.4",
    "@clockwyrks/run-stats": "0.1.0",
    "@clockwyrks/voxel-runtime": "1.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/doto": "^5.3.0",
    "@observablehq/plot": "^0.6.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "gifenc": "^1.0.3",
    "highlight.js": "^11.12.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "react-toastify": "^11.0.5",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "three": "~0.185.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1"
  },
  "devDependencies": {
    "@clockwyrks/simple-2d": "1.1.2",
    "@clockwyrks/structured-2d": "1.1.2",
    "@napi-rs/canvas": "^1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.185.0",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^26",
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1",
    "typescript": "^6",
    "vitest": "^5"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/genyume/the-test-cabinet/_packaging/the-test-cabinet/npm/registry/"
  }
}
